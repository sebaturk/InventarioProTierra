rules_version = '2';

// Las fotos se sirven públicamente sin token (para poder armar la URL
// directamente desde el id guardado en Firestore). Solo un usuario
// autenticado (aunque sea de forma anónima, como hace la app al abrir)
// puede subir, y se limita el tamaño y el tipo de archivo.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
