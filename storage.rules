// OBSOLETO — esta app ya NO usa Firebase Storage (ver README, sección de
// Costos). Las fotos se guardan como base64 directo en Firestore para
// evitar el requisito del plan Blaze. Dejo este archivo por si en el
// futuro vuelven a necesitar Storage para adjuntos más pesados.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
